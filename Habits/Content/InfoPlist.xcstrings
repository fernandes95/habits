{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow location access to get reminded of your habits when you arrive at the places you set for them, even when the app is closed."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à localização para receber lembretes dos seus hábitos quando chegar aos locais definidos para eles, mesmo com a app fechada."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Allow location access to show where you are on the map while picking the places for your habit reminders."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à localização para mostrar onde está no mapa enquanto escolhe os locais para os lembretes dos seus hábitos."
          }
        }
      }
    }
  },
  "version" : "1.0"
}