      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Always” location is turned off for World of habits, so it can’t remind you when you arrive. Your reminder stays on and starts again once you allow it in Settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização “Sempre” está desativada para o World of habits, então você não vai receber lembretes quando chegar. O lembrete continua ativado e volta a funcionar assim que você permitir nos Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
