    "habit_location_always_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To remind you when you arrive at the selected location, World of habits needs your location even when the app is closed. Without “Always”, you won’t get this reminder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para lembrar você quando chegar à localização selecionada, o World of habits precisa da sua localização mesmo com o app fechado. Sem “Sempre”, você não receberá este lembrete."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber um lembrete quando chegar à localização selecionada, o World of habits precisa de aceder à sua localização mesmo com a app fechada. Sem “Sempre”, não receberá este lembrete."
          }
        }
      }
    },
