    "quote_eight" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The great thing in this world is not so much where we are, but in what direction we are going.”\n\n―Oliver Wendell Holmes Jr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O mais importante neste mundo não é tanto onde estamos, mas a direção em que seguimos.”\n\n―Oliver Wendell Holmes Jr."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O mais importante neste mundo não é tanto onde estamos, mas a direção em que seguimos.”\n\n―Oliver Wendell Holmes Jr."
          }
        }
      }
    },
    "quote_eighteen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Winners make a habit of manufacturing their own positive expectations in advance of the event.”\n\n―Brian Tracy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Os vencedores criam o hábito de fabricar suas próprias expectativas positivas antes que o evento aconteça.”\n\n―Brian Tracy"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Os vencedores criam o hábito de fabricar as suas próprias expectativas positivas antes de o acontecimento chegar.”\n\n―Brian Tracy"
          }
        }
      }
    },
    "quote_eleven" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I can and I will. Watch me.”\n\n―Carrie Green, Female Entrepreneur Association"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Eu consigo e vou conseguir. Vejam só.”\n\n―Carrie Green, Female Entrepreneur Association"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Eu consigo e vou conseguir. Vejam só.”\n\n―Carrie Green, Female Entrepreneur Association"
          }
        }
      }
    },
    "quote_fifteen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“See yourself living in abundance and you will attract it.”\n\n―Rhonda Byrne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Veja-se vivendo em abundância e você vai atraí-la.”\n\n―Rhonda Byrne"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Veja-se a viver em abundância e irá atraí-la.”\n\n―Rhonda Byrne"
          }
        }
      }
    },
    "quote_five" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“He who has a why to live can bear almost any how.”\n\n―Nietzsche"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Quem tem um porquê para viver suporta quase qualquer como.”\n\n―Nietzsche"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Quem tem um porquê para viver suporta quase qualquer como.”\n\n―Nietzsche"
          }
        }
      }
    },
    "quote_four" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The mystery of human existence lies not in just staying alive, but in finding something to live for.”\n\n―Fyodor Dostoyevsky"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O mistério da existência humana não está apenas em continuar vivo, mas em encontrar algo pelo qual viver.”\n\n―Fiódor Dostoiévski"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O mistério da existência humana não está apenas em continuar vivo, mas em encontrar algo pelo qual viver.”\n\n―Fiódor Dostoiévski"
          }
        }
      }
    },
    "quote_fourteen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Would you like me to give you a formula for success? It’s quite simple, really: Double your rate of failure. You are thinking of failure as the enemy of success. But it isn’t at all. You can be discouraged by failure or you can learn from it, so go ahead and make mistakes. Make all you can. Because remember that’s where you will find success.”\n\n―Thomas J. Watson"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Quer que eu lhe dê uma fórmula para o sucesso? É bem simples, na verdade: dobre sua taxa de fracasso. Você está pensando no fracasso como inimigo do sucesso. Mas não é, de jeito nenhum. Você pode se desanimar com o fracasso ou aprender com ele, então vá em frente e cometa erros. Cometa todos que puder. Porque lembre-se: é aí que você vai encontrar o sucesso.”\n\n―Thomas J. Watson"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Quer que lhe dê uma fórmula para o sucesso? É bastante simples, na verdade: duplique a sua taxa de fracasso. Está a pensar no fracasso como inimigo do sucesso. Mas não é, de todo. Pode deixar-se desanimar pelo fracasso ou aprender com ele, por isso avance e cometa erros. Cometa todos os que puder. Porque lembre-se: é aí que vai encontrar o sucesso.”\n\n―Thomas J. Watson"
          }
        }
      }
    },
    "quote_fourty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Do not wait; the time will never be ‘just right.’ Start where you stand, and work with whatever tools you may have at your command, and better tools will be found as you go along.”\n\n―Napoleon Hill"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Não espere; o momento nunca será o ‘certo’. Comece de onde está e trabalhe com as ferramentas que tiver à disposição; ferramentas melhores vão surgindo pelo caminho.”\n\n―Napoleon Hill"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Não espere; o momento nunca será o ‘certo’. Comece onde está e trabalhe com as ferramentas que tiver à disposição; melhores ferramentas irão surgindo pelo caminho.”\n\n―Napoleon Hill"
          }
        }
      }
    },
    "quote_fourty_one" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Life is a journey, and if you fall in love with the journey, you will be in love forever.”\n\n―Peter Hagerty"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A vida é uma jornada e, se nos apaixonarmos pela jornada, estaremos apaixonados para sempre.”\n\n―Peter Hagerty"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A vida é uma viagem e, se nos apaixonarmos pela viagem, estaremos apaixonados para sempre.”\n\n―Peter Hagerty"
          }
        }
      }
    },
    "quote_nine" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Success, like happiness, cannot be pursued. It must ensue. And it only does so as the unintended side of one’s personal dedication to a cause greater than oneself.”\n\n―Viktor Frankl"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O sucesso, assim como a felicidade, não pode ser perseguido. Ele tem que acontecer. E só acontece como efeito colateral, não intencional, da dedicação pessoal a uma causa maior do que nós mesmos.”\n\n―Viktor Frankl"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O sucesso, tal como a felicidade, não pode ser perseguido. Tem de acontecer. E só acontece como efeito secundário, não intencional, da dedicação pessoal a uma causa maior do que nós próprios.”\n\n―Viktor Frankl"
          }
        }
      }
    },
    "quote_nineteen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“You manifest what you believe, not what you want.”\n\n―Sonia Ricotti"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Manifestamos aquilo em que acreditamos, não aquilo que queremos.”\n\n―Sonia Ricotti"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Manifestamos aquilo em que acreditamos, não aquilo que queremos.”\n\n―Sonia Ricotti"
          }
        }
      }
    },
    "quote_one" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Definiteness of purpose is the starting point from which one must begin”\n\n―Napoleon Hill"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A definição de um propósito é o ponto de partida de onde se deve começar.”\n\n―Napoleon Hill"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A definição de um propósito é o ponto de partida de onde se deve começar.”\n\n―Napoleon Hill"
          }
        }
      }
    },
    "quote_seven" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The two most important days in life are the day you born and the day you discover the reason why.”\n\n―Mark Twain"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Os dois dias mais importantes da vida são o dia em que nascemos e o dia em que descobrimos por quê.”\n\n―Mark Twain"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Os dois dias mais importantes da vida são o dia em que nascemos e o dia em que descobrimos porquê.”\n\n―Mark Twain"
          }
        }
      }
    },
    "quote_seventeen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Set a goal, not only to follow world-class role models, but to become a world-class role model.”\n\n―Steve Siebold, Author"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tenha como meta não só seguir modelos de referência de nível mundial, mas se tornar um.”\n\n―Steve Siebold, autor"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Defina como objetivo não só seguir modelos de referência de nível mundial, mas tornar-se um.”\n\n―Steve Siebold, autor"
          }
        }
      }
    },
    "quote_six" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The person without a purpose is like a ship without a rudder.”\n\n―Thomas Carlyle"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uma pessoa sem propósito é como um navio sem leme.”\n\n―Thomas Carlyle"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uma pessoa sem propósito é como um navio sem leme.”\n\n―Thomas Carlyle"
          }
        }
      }
    },
    "quote_sixteen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Success is not to be pursued; it is attracted by the person you become.”\n\n―Jim Rohn"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O sucesso não se persegue; ele é atraído pela pessoa em que nos tornamos.”\n\n―Jim Rohn"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O sucesso não se persegue; é atraído pela pessoa em que nos tornamos.”\n\n―Jim Rohn"
          }
        }
      }
    },
    "quote_ten" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“If you set your goals ridiculously high and it’s a failure, you will fail above everyone else’s success.”\n\n―James Cameron"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Se definirmos metas ridiculamente altas e falharmos, falharemos acima do sucesso de todos os outros.”\n\n―James Cameron"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Se definirmos objetivos ridiculamente altos e falharmos, falharemos acima do sucesso de todos os outros.”\n\n―James Cameron"
          }
        }
      }
    },
    "quote_thirteen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Successful people do what unsuccessful people are not willing to do. Don’t wish it were easier; wish you were better.”\n\n―Jim Rohn"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pessoas de sucesso fazem o que pessoas sem sucesso não estão dispostas a fazer. Não deseje que seja mais fácil; deseje ser melhor.”\n\n―Jim Rohn"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“As pessoas de sucesso fazem o que as pessoas sem sucesso não estão dispostas a fazer. Não deseje que seja mais fácil; deseje ser melhor.”\n\n―Jim Rohn"
          }
        }
      }
    },
    "quote_thirty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The law of life is the law of belief.”\n\n―Joseph Murphy, Ph.D."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A lei da vida é a lei da crença.”\n\n―Joseph Murphy, Ph.D."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A lei da vida é a lei da crença.”\n\n―Joseph Murphy, Ph.D."
          }
        }
      }
    },
    "quote_thirty_eight" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Remember that the happiest people are not those getting more, but those giving more.”\n\n―H. Jackson Brown Jr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Lembre-se de que as pessoas mais felizes não são as que recebem mais, mas as que dão mais.”\n\n―H. Jackson Brown Jr."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Lembre-se de que as pessoas mais felizes não são as que recebem mais, mas as que dão mais.”\n\n―H. Jackson Brown Jr."
          }
        }
      }
    },
    "quote_thirty_five" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“At some point, the pain of not doing it becomes greater than the pain of doing it.”\n\n―Steven Pressfield, The War of Art"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Em algum momento, a dor de não fazer se torna maior do que a dor de fazer.”\n\n―Steven Pressfield, The War of Art"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A certa altura, a dor de não o fazer torna-se maior do que a dor de o fazer.”\n\n―Steven Pressfield, The War of Art"
          }
        }
      }
    },
    "quote_thirty_four" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The key to life is accepting challenges. Once someone stops doing this, he’s dead.”\n\n―Bette Davis"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A chave da vida é aceitar desafios. Quando alguém para de fazer isso, está morto.”\n\n―Bette Davis"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A chave da vida é aceitar desafios. Quando alguém deixa de o fazer, está morto.”\n\n―Bette Davis"
          }
        }
      }
    },
    "quote_thirty_nine" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The only impossible journey is the one you never begin.”\n\n―Tony Robbins   "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A única jornada impossível é aquela que você nunca começa.”\n\n―Tony Robbins"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A única viagem impossível é aquela que nunca começamos.”\n\n―Tony Robbins"
          }
        }
      }
    },
    "quote_thirty_one" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Go the extra mile, it’s never crowded.”\n\n―Jay Shetty"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vá além: nesse quilômetro extra nunca tem multidão.”\n\n―Jay Shetty"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vá mais longe: nesse quilómetro extra nunca há multidões.”\n\n―Jay Shetty"
          }
        }
      }
    },
    "quote_thirty_seven" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Don’t be in the business of playing it safe. Be in the business of creating possibilities for greatness.”\n\n―Robert Iger, Chairman of Disney"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Não se dedique a jogar no seguro. Dedique-se a criar possibilidades de grandeza.”\n\n―Robert Iger, presidente da Disney"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Não se dedique a jogar pelo seguro. Dedique-se a criar possibilidades de grandeza.”\n\n―Robert Iger, presidente da Disney"
          }
        }
      }
    },
    "quote_thirty_six" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“There is a place that you are to fill and no one else can fill, something you are to do, which no one else can do.”\n\n―Florence Scovel Shinn, The Game of Life"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Há um lugar que cabe a nós ocupar e que mais ninguém pode ocupar, algo que cabe a nós fazer e que mais ninguém pode fazer.”\n\n―Florence Scovel Shinn, The Game of Life"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Há um lugar que nos cabe ocupar e que mais ninguém pode ocupar, algo que nos cabe fazer e que mais ninguém pode fazer.”\n\n―Florence Scovel Shinn, The Game of Life"
          }
        }
      }
    },
    "quote_thirty_three" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“One of the secrets of life is to make stepping stones out of stumbling blocks.”\n\n―Jack Penn"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Um dos segredos da vida é transformar obstáculos em degraus.”\n\n―Jack Penn"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Um dos segredos da vida é transformar obstáculos em degraus.”\n\n―Jack Penn"
          }
        }
      }
    },
    "quote_thirty_two" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Wheresoever you go, go with all your heart.”\n\n―Confucius"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aonde quer que você vá, vá de todo o coração.”\n\n―Confúcio"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Para onde quer que vá, vá de todo o coração.”\n\n―Confúcio"
          }
        }
      }
    },
    "quote_three" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“And actually, it’s not repetition that creates habits. It’s emotions that creates habits.”\n\n―Rangan Chatterjee"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Na verdade, não é a repetição que cria hábitos. São as emoções que criam hábitos.”\n\n―Rangan Chatterjee"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Na verdade, não é a repetição que cria hábitos. São as emoções que criam hábitos.”\n\n―Rangan Chatterjee"
          }
        }
      }
    },
    "quote_twelve" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“To bring anything into your life, imagine that it’s already there.”\n\n―Richard Bach"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Para trazer qualquer coisa para a nossa vida, basta imaginar que ela já está lá.”\n\n―Richard Bach"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Para trazer qualquer coisa para a nossa vida, basta imaginar que já lá está.”\n\n―Richard Bach"
          }
        }
      }
    },
    "quote_twenty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We become what we think about. Energy flows where attention goes.”\n\n―Rhonda Byrne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nós nos tornamos aquilo em que pensamos. A energia flui para onde vai a atenção.”\n\n―Rhonda Byrne"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tornamo-nos naquilo em que pensamos. A energia flui para onde vai a atenção.”\n\n―Rhonda Byrne"
          }
        }
      }
    },
    "quote_twenty_eight" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“As long as you live, keep learning how to live.”\n\n―Seneca"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Enquanto viver, continue aprendendo a viver.”\n\n―Sêneca"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Enquanto viver, continue a aprender a viver.”\n\n―Séneca"
          }
        }
      }
    },
    "quote_twenty_five" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Whether you think you can or think you can’t, you’re right.”\n\n―Henry Ford"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Se você acha que consegue ou acha que não consegue, você está certo.”\n\n―Henry Ford"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Quer pense que consegue, quer pense que não consegue, tem razão.”\n\n―Henry Ford"
          }
        }
      }
    },
    "quote_twenty_four" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The secret of getting ahead is getting started.”\n\n―Mark Twain"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O segredo para progredir é começar.”\n\n―Mark Twain"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O segredo para avançar é começar.”\n\n―Mark Twain"
          }
        }
      }
    },
    "quote_twenty_nine" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I think goals should never be easy, they should force you to work, even if they are uncomfortable at the time.”\n\n—Michael Phelps"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Acho que as metas nunca devem ser fáceis; elas devem nos obrigar a trabalhar, mesmo que sejam desconfortáveis no momento.”\n\n—Michael Phelps"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Acho que os objetivos nunca devem ser fáceis; devem obrigar-nos a trabalhar, mesmo que sejam desconfortáveis no momento.”\n\n—Michael Phelps"
          }
        }
      }
    },
    "quote_twenty_one" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The price of greatness is responsibility.”\n\n―Winston Churchill"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O preço da grandeza é a responsabilidade.”\n\n―Winston Churchill"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O preço da grandeza é a responsabilidade.”\n\n―Winston Churchill"
          }
        }
      }
    },
    "quote_twenty_seven" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Good things come to people who wait, but better things come to those who go out and get them.”\n\n―Abraham Lincoln"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Coisas boas chegam para quem espera, mas coisas melhores chegam para quem vai atrás delas.”\n\n―Abraham Lincoln"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“As coisas boas chegam a quem espera, mas as melhores chegam a quem vai à procura delas.”\n\n―Abraham Lincoln"
          }
        }
      }
    },
    "quote_twenty_six" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Destiny is not a matter of chance, it is a matter of choice.”\n\n―William Jennings Bryan"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O destino não é uma questão de sorte, é uma questão de escolha.”\n\n―William Jennings Bryan"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O destino não é uma questão de sorte, é uma questão de escolha.”\n\n―William Jennings Bryan"
          }
        }
      }
    },
    "quote_twenty_three" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“What you do every day matters more than what you do once in a while”.\n\n―Gretchen Rubin"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O que fazemos todos os dias importa mais do que o que fazemos de vez em quando.”\n\n―Gretchen Rubin"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“O que fazemos todos os dias importa mais do que o que fazemos de vez em quando.”\n\n―Gretchen Rubin"
          }
        }
      }
    },
    "quote_twenty_two" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Each day is an opportunity to craft your best life. Each day brings a chance to choose your greatness.”\n\n―Robin Sharma"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cada dia é uma oportunidade de construir a nossa melhor vida. Cada dia traz a chance de escolher a nossa grandeza.”\n\n―Robin Sharma"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cada dia é uma oportunidade para construir a nossa melhor vida. Cada dia traz a possibilidade de escolher a nossa grandeza.”\n\n―Robin Sharma"
          }
        }
      }
    },
    "quote_two" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“It’s not about who you are today, it’s about who you want to become and the price you are willing to pay to get there.”\n\n―Tom Bilyeu, Founder Impact Theory"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Não se trata de quem somos hoje, mas de quem queremos nos tornar e do preço que estamos dispostos a pagar para chegar lá.”\n\n―Tom Bilyeu, fundador da Impact Theory"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Não se trata de quem somos hoje, mas de quem queremos vir a ser e do preço que estamos dispostos a pagar para lá chegar.”\n\n―Tom Bilyeu, fundador da Impact Theory"
          }
        }
      }
    },
